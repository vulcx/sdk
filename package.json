{
  "name": "@vulcx/sdk",
  "version": "0.6.0",
  "description": "TypeScript client for Vulcx, the best-price swap router for Fogo \u2014 multi-hop split routing, firm quotes, and ready-to-sign transactions.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit && npm run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^22.20.1",
    "rollup": "^4.34.8",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vulcx/sdk"
  },
  "keywords": [
    "solana",
    "dex",
    "aggregator",
    "swap",
    "fogo",
    "vulcx",
    "svm",
    "defi",
    "firm-quotes",
    "valiant"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
